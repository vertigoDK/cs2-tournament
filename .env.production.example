# Скопируйте в .env.production НА СЕРВЕРЕ (в /opt/cs2-tournament) и заполните.
# Этот файл в rsync не попадает и в git не коммитится — деплой его не трогает.

# Домен, на который смотрит A-запись — Caddy сам выпустит и обновит
# сертификат Let's Encrypt именно под него.
DOMAIN=example.com

# Ключ для подписи JWT — случайная строка, смените обязательно.
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-string

# Используются только если в базе ещё нет пользователя admin — на боевой
# базе, перенесённой с локали, аккаунт уже есть и эти значения не влияют.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
