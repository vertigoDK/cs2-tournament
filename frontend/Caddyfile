{$DOMAIN} {
	encode gzip

	# API и загруженные картинки отдаёт бэкенд.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}

	# Всё остальное — собранный React SPA со стороны Caddy.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
