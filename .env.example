# Скопируйте этот файл в .env и поменяйте значения перед запуском.

# Ключ для подписи JWT — обязательно смените на случайную строку.
SECRET_KEY=change-me-to-a-random-string

# Единственный аккаунт, который создаётся автоматически.
# Всех участников заводит админ на странице «Участники»:
# логин и пароль там генерируются случайно и показываются один раз.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# База. Локально по умолчанию SQLite-файл backend/data/app.db.
# На Vercel сюда попадает строка подключения Neon Postgres
# (интеграция Neon сама заводит переменную DATABASE_URL).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
